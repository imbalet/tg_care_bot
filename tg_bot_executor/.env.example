# Executor Telegram bot local environment.
# Copy this file to .env and provide a real bot token before polling Telegram.

# Logging
LOG_LEVEL=INFO                 # Minimum log level emitted by the bot.

# Telegram
BOT_TOKEN=replace-with-executor-bot-token  # Secret token issued by BotFather for the executor bot.

# Backend API
BACKEND_SCHEME=http            # URL scheme used to reach the backend.
BACKEND_HOST=localhost         # Backend hostname; use "api" when running in Docker Compose.
BACKEND_PORT=8000              # Backend port; use its internal Compose port in Docker.
SERVICE_KEY=dev-service-key    # Shared key sent with authenticated backend requests.

# Redis FSM and UI state
REDIS_HOST=localhost            # Redis hostname; use "redis" when running in Docker Compose.
REDIS_PORT=6379                # Redis port.
REDIS_DB=2                      # Redis database reserved for executor-bot state.
REDIS_PASSWORD=                # Redis password; empty means authentication is disabled locally.

# HTTP client
REQUEST_TIMEOUT_SECONDS=5      # Timeout for one backend API request.
