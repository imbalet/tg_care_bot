# Deployment image coordinates
IMAGE_NAMESPACE=ghcr.io/imbalet/tg_care_bot
IMAGE_TAG=latest

# Application
APP_ENV=production
APP_NAME=we-are-close-api
LOG_LEVEL=INFO

# Published application ports
API_PORT=18000
ADMIN_PORT=18001

# PostgreSQL
POSTGRES_DB=we_are_close
POSTGRES_USER=we_are_close
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Redis
REDIS_PASSWORD=replace-with-a-long-random-password

# Internal authentication between bots and backend
SERVICE_KEY=replace-with-a-long-random-service-key

# Database-driven worker
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_BATCH_LIMIT=50

# MinIO / S3-compatible storage
MINIO_ROOT_USER=replace-with-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-password
S3_BUCKET=we-are-close-files
S3_REGION=us-east-1
S3_SIGNED_URL_TTL_SECONDS=900

# Telegram
CUSTOMER_BOT_TOKEN=replace-with-customer-bot-token
EXECUTOR_BOT_TOKEN=replace-with-executor-bot-token
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=5
BOT_REQUEST_TIMEOUT_SECONDS=5

# Geocoding
DADATA_API_KEY=replace-with-dadata-api-key
DADATA_SECRET_KEY=replace-with-dadata-secret-key
DADATA_BASE_URL=https://suggestions.dadata.ru
DADATA_TIMEOUT_SECONDS=2
DADATA_RETRY_COUNT=1

# Payments
PAYMENT_PROVIDER=tbank_test
TBANK_BASE_URL=https://rest-api-test.tinkoff.ru/v2
TBANK_TERMINAL_KEY=replace-with-tbank-terminal-key
TBANK_PASSWORD=replace-with-tbank-password
TBANK_TIMEOUT_SECONDS=5
TBANK_NOTIFICATION_URL=https://example.com/api/payments/webhooks/tbank

# Receipt settings; verify these values with the merchant's tax configuration.
PAYMENT_RECEIPT_TAXATION=usn_income
PAYMENT_RECEIPT_TAX=none
PAYMENT_RECEIPT_METHOD=full_payment
PAYMENT_RECEIPT_OBJECT=service
PAYMENT_RECEIPT_DEFAULTS_ALLOWED=false

# Initial administrator. Change the password after the first login.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_FULL_NAME=Administrator
DEFAULT_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional T-Bank mock profile
TBANK_MOCK_PORT=18080
TBANK_MOCK_PUBLIC_BASE_URL=http://localhost:18080
TBANK_MOCK_WEBHOOK_TIMEOUT_SECONDS=3
TBANK_MOCK_WEBHOOK_RETRY_COUNT=5
TBANK_MOCK_WEBHOOK_RETRY_DELAY_SECONDS=1
