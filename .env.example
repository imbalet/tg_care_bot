# Local Docker Compose environment.
# Copy this file to .env and replace every placeholder secret before use.

# Application
APP_ENV=local                         # Runtime environment: local, test, or production.
APP_NAME=we-are-close-api             # Human-readable application name used in logs.
LOG_LEVEL=INFO                         # Minimum log level: DEBUG, INFO, WARNING, or ERROR.

# PostgreSQL container
POSTGRES_DB=we_are_close               # Database name created by PostgreSQL.
POSTGRES_USER=postgres                 # PostgreSQL login used by the application.
POSTGRES_PASSWORD=postgres             # PostgreSQL password; use a strong secret outside local development.

# Redis
REDIS_PASSWORD=                        # Redis password; empty means authentication is disabled locally.

# Internal authentication
SERVICE_KEY=dev-service-key             # Shared key used to authenticate bot-to-backend requests.

# Database-driven worker
WORKER_POLL_INTERVAL_SECONDS=1          # Delay between worker polling attempts.
WORKER_BATCH_LIMIT=50                   # Maximum number of outbox jobs claimed per poll.

# MinIO root credentials
MINIO_ROOT_USER=minio                   # MinIO administrator username for local development.
MINIO_ROOT_PASSWORD=minio-password      # MinIO administrator password for local development.

# S3-compatible object storage
S3_ENDPOINT_URL=http://minio:9000       # Internal Compose URL of the S3-compatible storage service.
S3_ACCESS_KEY_ID=minio                  # Access key used by the backend to access object storage.
S3_SECRET_ACCESS_KEY=minio-password     # Secret key used by the backend to access object storage.
S3_BUCKET=we-are-close-files            # Private bucket for uploaded files.
S3_REGION=us-east-1                     # S3 region used for request signing.
S3_SIGNED_URL_TTL_SECONDS=900           # Lifetime of generated download URLs.

# Telegram integration
CUSTOMER_BOT_TOKEN=replace-with-customer-bot-token  # Telegram token for the customer bot.
EXECUTOR_BOT_TOKEN=replace-with-executor-bot-token  # Telegram token for the executor bot.
TELEGRAM_API_BASE_URL=https://api.telegram.org      # Telegram Bot API base URL.
TELEGRAM_TIMEOUT_SECONDS=5             # Timeout for backend-to-Telegram API requests.
BOT_REQUEST_TIMEOUT_SECONDS=5           # Timeout used by Telegram bots for backend requests.

# Address geocoding
DADATA_API_KEY=                         # DaData API key; required when real geocoding is enabled.
DADATA_SECRET_KEY=                      # DaData secret key; required when real geocoding is enabled.
DADATA_BASE_URL=https://suggestions.dadata.ru  # DaData API base URL.
DADATA_TIMEOUT_SECONDS=2                # Timeout for a single DaData request.
DADATA_RETRY_COUNT=1                     # Number of retries after a failed DaData request.

# Payments
PAYMENT_PROVIDER=tbank_test             # Configured payment provider implementation.
TBANK_BASE_URL=https://rest-api-test.tinkoff.ru/v2  # T-Bank API base URL.
TBANK_TERMINAL_KEY=replace-with-tbank-test-terminal-key  # T-Bank terminal identifier.
TBANK_PASSWORD=replace-with-tbank-test-password       # T-Bank terminal password.
TBANK_TIMEOUT_SECONDS=5                 # Timeout for T-Bank API requests.
TBANK_NOTIFICATION_URL=                 # Public HTTPS URL for /api/payments/webhooks/tbank.
TBANK_MOCK_PUBLIC_BASE_URL=http://localhost:18080  # Browser URL for the optional local payment form.
TBANK_MOCK_WEBHOOK_TIMEOUT_SECONDS=3    # HTTP timeout for mock webhook delivery.
TBANK_MOCK_WEBHOOK_RETRY_COUNT=5        # Maximum mock webhook delivery attempts.
TBANK_MOCK_WEBHOOK_RETRY_DELAY_SECONDS=1 # Local retry delay for mock webhooks.
PAYMENT_RECEIPT_TAXATION=usn_income     # Must match the merchant's tax regime.
PAYMENT_RECEIPT_TAX=none                # Must match the online cash register settings.
PAYMENT_RECEIPT_METHOD=full_payment     # Payment method used in payment receipts.
PAYMENT_RECEIPT_OBJECT=service           # Receipt item type for the service.
PAYMENT_RECEIPT_DEFAULTS_ALLOWED=false  # Production must use explicit receipt settings.

# Initial administrator created by the migration
DEFAULT_ADMIN_EMAIL=admin@example.local # Email address of the initial administrator.
DEFAULT_ADMIN_FULL_NAME=admin            # Display name of the initial administrator.
DEFAULT_ADMIN_PASSWORD=password          # Initial administrator password; change it outside local development.
