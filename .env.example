APP_ENV=local
APP_NAME=we-are-close-api

LOG_LEVEL=INFO

POSTGRES_DB=we_are_close
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_PASSWORD=

SERVICE_KEY=dev-service-key

WORKER_POLL_INTERVAL_SECONDS=1
WORKER_BATCH_LIMIT=50

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-password

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-password
S3_BUCKET=we-are-close-files
S3_REGION=us-east-1
S3_SIGNED_URL_TTL_SECONDS=900

CUSTOMER_BOT_TOKEN=replace-with-customer-bot-token
EXECUTOR_BOT_TOKEN=replace-with-executor-bot-token
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=5
BOT_REQUEST_TIMEOUT_SECONDS=5

DADATA_API_KEY=
DADATA_SECRET_KEY=
DADATA_BASE_URL=https://suggestions.dadata.ru
DADATA_TIMEOUT_SECONDS=2
DADATA_RETRY_COUNT=1

PAYMENT_PROVIDER=tbank_test
TBANK_BASE_URL=https://rest-api-test.tinkoff.ru/v2
TBANK_TERMINAL_KEY=replace-with-tbank-test-terminal-key
TBANK_PASSWORD=replace-with-tbank-test-password
TBANK_TIMEOUT_SECONDS=5
TBANK_NOTIFICATION_URL=
PAYMENT_RECEIPT_TAXATION=osn
PAYMENT_RECEIPT_TAX=vat20
PAYMENT_RECEIPT_METHOD=full_prepayment
PAYMENT_RECEIPT_OBJECT=service
PAYMENT_RECEIPT_DEFAULTS_ALLOWED=true

DEFAULT_ADMIN_EMAIL=admin@example.local
DEFAULT_ADMIN_FULL_NAME=admin
DEFAULT_ADMIN_PASSWORD=password
